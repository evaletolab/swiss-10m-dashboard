# Data mode: auto, mock, manual, or official.
# auto uses manual/official files when present and falls back to mock data.
DATA_MODE=auto

# OFS STAT-TAB PX-Web. Fill only after confirming the exact cube URL.
BFS_POPULATION_BALANCE_PXWEB_URL=
BFS_FERTILITY_PXWEB_URL=
BFS_SCENARIOS_PXWEB_URL=

# OCSTAT files. Prefer CSV/XLSX over PDF when available.
OCSTAT_GE_DEMOGRAPHY_URL=
OCSTAT_GE_HOUSING_URL=
OCSTAT_GE_PRICES_URL=
OCSTAT_GE_TRANSPORT_URL=

# OFSP / opendata.swiss health insurance premiums.
OFSP_LAMAL_PREMIUMS_URL=
# Large ZIP archives 2011, 2013, 2015, 2017, 2019, 2021, 2023, 2025.
# Keep false unless you want the download script to fetch all archives.
OFSP_DOWNLOAD_ARCHIVES=false

# OFS/OFL vacant dwellings source.
OFL_VACANCY_RATE_URL=
